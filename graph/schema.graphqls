# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type Todo {
  id: ID!
  text: String!
  done: Boolean!
  user: User!
}

type User {
  id: ID!
  name: String!
}

type Query {
  getTodo(id: ID!): Todo!
  todos: [Todo!]!
}

input NewTodo {
  text: String!
  userId: String!
}

input UpdateTodo {
  todoId: String!
  text: String!
  done: Boolean!
}

type Mutation {
  createTodo(input: NewTodo!): Todo
  updateTodo(input: UpdateTodo!): Todo
}
